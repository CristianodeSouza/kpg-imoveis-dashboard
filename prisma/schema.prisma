generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                String          @id @default(cuid())
  clientCode        String?         @unique
  name              String
  slug              String          @unique
  status            String          @default("active")
  billingStatus     String          @default("active")
  document          String          @default("")
  contactName       String          @default("")
  contactEmail      String          @default("")
  contactPhone      String          @default("")
  monthlyValueCents Int             @default(0)
  acquiredAt        DateTime?
  notes             String          @default("")
  users             User[]
  settings          TenantSettings?
  services          TenantService[]
  auditLogs         AuditLog[]
  publicationLogs   PublicationLog[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model User {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String?    @unique
  username        String     @unique
  passwordHash    String
  role            String     @default("owner")
  isPlatformAdmin Boolean    @default(false)
  auditLogs       AuditLog[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Service {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String?
  href           String
  icon           String          @default("app")
  status         String          @default("active")
  tenantServices TenantService[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TenantService {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     String    @default("active")
  plan       String    @default("starter")
  priceCents Int       @default(0)
  limits     Json?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, serviceId])
}

model TenantSettings {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  tenant                        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName                   String
  sigaEndpoint                  String   @default("")
  sigaTokenEncrypted            String?
  metaAppId                     String   @default("")
  metaAppSecretEncrypted        String?
  instagramAccountId            String   @default("")
  instagramAccessTokenEncrypted String?
  makeBaseUrl                   String   @default("")
  makeDataStoreId               String   @default("")
  makeApiTokenEncrypted         String?
  whatsappNumber                String   @default("")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model PublicationLog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  propertyCode   String   @default("")
  caption        String   @default("")
  instagramPostId String  @default("")
  instagramUrl   String   @default("")
  mediaType      String   @default("post")
  photosCount    Int      @default(0)
  status         String   @default("published")
  cycleStart     DateTime
  cycleEnd       DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, cycleStart, cycleEnd])
}
