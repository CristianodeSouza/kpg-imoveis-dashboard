generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                String          @id @default(cuid())
  clientCode        String?         @unique
  name              String
  slug              String          @unique
  status            String          @default("active")
  billingStatus     String          @default("active")
  legalName         String          @default("")
  document          String          @default("")
  contactName       String          @default("")
  contactEmail      String          @default("")
  contactPhone      String          @default("")
  addressZip        String          @default("")
  addressStreet     String          @default("")
  addressNumber     String          @default("")
  addressDistrict   String          @default("")
  addressComplement String          @default("")
  addressCity       String          @default("")
  addressState      String          @default("")
  monthlyValueCents Int             @default(0)
  acquiredAt        DateTime?
  notes             String          @default("")
  users             User[]
  settings          TenantSettings?
  services          TenantService[]
  auditLogs         AuditLog[]
  publicationLogs   PublicationLog[]
  socialPublications SocialPublication[]
  googleBusinessPosts GoogleBusinessPost[]
  propertyCaches     PropertyCache[]
  paymentRecords    PaymentRecord[]
  blogProfile       BlogProfile?
  blogPosts         BlogPost[]
  seoSites          SeoSite[]
  seoCredentials    SeoCredential?
  seoRecommendations SeoRecommendation[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model User {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  email           String?    @unique
  username        String     @unique
  passwordHash    String
  role            String     @default("owner")
  isPlatformAdmin Boolean    @default(false)
  auditLogs       AuditLog[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Service {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  description    String?
  href           String
  icon           String          @default("app")
  status         String          @default("active")
  tenantServices TenantService[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TenantService {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     String    @default("active")
  plan       String    @default("starter")
  priceCents Int       @default(0)
  limits     Json?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, serviceId])
}

model TenantSettings {
  id                            String   @id @default(cuid())
  tenantId                      String   @unique
  tenant                        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName                   String
  sigaBaseUrl                   String   @default("https://api.sigacrm.com.br")
  sigaSlug                      String   @default("")
  sigaEndpoint                  String   @default("")
  sigaTokenEncrypted            String?
  metaAppId                     String   @default("")
  metaAppSecretEncrypted        String?
  instagramAccountId            String   @default("")
  instagramAccessTokenEncrypted String?
  makeBaseUrl                   String   @default("")
  makeDataStoreId               String   @default("")
  makeApiTokenEncrypted         String?
  googleBusinessAccountId       String   @default("")
  googleBusinessLocationId      String   @default("")
  googleBusinessRefreshTokenEncrypted String?
  googleBusinessAccessTokenEncrypted  String?
  googleBusinessTokenExpiresAt  DateTime?
  whatsappNumber                String   @default("")
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model PublicationLog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  propertyCode   String   @default("")
  caption        String   @default("")
  instagramPostId String  @default("")
  instagramUrl   String   @default("")
  mediaType      String   @default("post")
  photosCount    Int      @default(0)
  status         String   @default("published")
  cycleStart     DateTime
  cycleEnd       DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, cycleStart, cycleEnd])
}

model SocialPublication {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId          String?
  propertyCode    String   @default("")
  propertyUrl     String   @default("")
  channels        Json
  instagramStatus String   @default("skipped")
  instagramPostId String   @default("")
  instagramUrl    String   @default("")
  gmbStatus       String   @default("skipped")
  gmbPostId       String   @default("")
  gmbUrl          String   @default("")
  errorMessage    String   @default("")
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, propertyCode])
}

model GoogleBusinessPost {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  propertyCode String @default("")
  accountId  String   @default("")
  locationId String   @default("")
  postId     String   @default("")
  topicType  String   @default("STANDARD")
  summary    String   @default("")
  imageUrl   String   @default("")
  ctaType    String   @default("LEARN_MORE")
  targetUrl  String   @default("")
  status     String   @default("LIVE")
  raw         Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, postId])
  @@map("google_business_posts")
}

model PropertyCache {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  origem        String   @default("")
  sourceUrl     String   @default("")
  imovel        Json
  property      Json
  lastSuccessAt DateTime @default(now())
  lastCheckedAt DateTime @default(now())
  failureCount  Int      @default(0)
  lastError     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, lastSuccessAt])
}

model PaymentRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  description String   @default("")
  amountCents Int      @default(0)
  paidAt      DateTime?
  dueAt       DateTime?
  status      String   @default("paid")
  method      String   @default("")
  receiptUrl  String   @default("")
  notes       String   @default("")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, paidAt])
  @@index([tenantId, dueAt])
}

model BlogProfile {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companyName         String   @default("")
  legalName           String   @default("")
  creci               String   @default("")
  address             String   @default("")
  city                String   @default("")
  state               String   @default("")
  phone               String   @default("")
  whatsapp            String   @default("")
  email               String   @default("")
  siteUrl             String   @default("")
  blogUrl             String   @default("")
  googleBusinessUrl   String   @default("")
  instagramUrl        String   @default("")
  institutionalText   String   @default("")
  differentials       String   @default("")
  services            String   @default("")
  propertyTypes       String   @default("")
  regions             String   @default("")
  keywords            String   @default("")
  forbiddenTopics     String   @default("")
  tone                String   @default("consultivo")
  targetAudience      String   @default("")
  sigaImobiliariaSlug String   @default("")
  sigaIdImob          Int      @default(1)
  sigaIdUsuario       Int      @default(1)
  sigaIdCategoria     Int      @default(1)
  defaultStatus       Int      @default(1)
  mostrarData         Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BlogPost {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topic         String   @default("")
  intent        String   @default("")
  region        String   @default("")
  propertyType  String   @default("")
  title         String
  slug          String
  description   String   @default("")
  tags          String   @default("")
  html          String   @default("")
  fonte         String   @default("")
  video         String   @default("")
  linkExterno   String   @default("")
  editorialStatus String @default("draft")
  sigaStatus    String   @default("not_sent")
  sigaPostId    String   @default("")
  sigaResponse  Json?
  payload       Json?
  seoScore      Int      @default(0)
  geoScore      Int      @default(0)
  slugScore     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  publishedAt   DateTime?

  @@unique([tenantId, slug])
  @@index([tenantId, createdAt])
  @@index([tenantId, editorialStatus])
}

model SeoCredential {
  id                          String   @id @default(cuid())
  tenantId                    String   @unique
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  googleAccountEmail          String   @default("")
  googleSearchConsoleProperty String   @default("")
  googleAccessTokenEncrypted  String?
  googleRefreshTokenEncrypted String?
  googleTokenExpiresAt        DateTime?
  scopes                      String   @default("")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model SeoSite {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  domain             String
  propertyUrl        String              @default("")
  sitemapUrl         String
  status             String              @default("active")
  seoScore           Int                 @default(0)
  indexationScore    Int                 @default(0)
  geoScore           Int                 @default(0)
  sitemapScore       Int                 @default(0)
  lastSitemapCheckAt DateTime?
  sitemapUrls        SeoSitemapUrl[]
  searchMetrics      SeoSearchMetric[]
  keywords           SeoKeyword[]
  pages              SeoPage[]
  urlInspections     SeoUrlInspection[]
  recommendations    SeoRecommendation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([tenantId, domain])
  @@index([tenantId, status])
}

model SeoSearchMetric {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  site        SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date        DateTime
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([siteId, date])
  @@index([tenantId, date])
}

model SeoKeyword {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  site        SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keyword     String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  trend       String   @default("stable")
  updatedAt   DateTime @updatedAt

  @@unique([siteId, keyword])
  @@index([tenantId, clicks])
}

model SeoPage {
  id          String   @id @default(cuid())
  tenantId    String
  siteId      String
  site        SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url         String
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  trend       String   @default("stable")
  updatedAt   DateTime @updatedAt

  @@unique([siteId, url])
  @@index([tenantId, clicks])
}

model SeoSitemapUrl {
  id           String   @id @default(cuid())
  tenantId     String
  siteId       String
  site         SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url          String
  lastmod      DateTime?
  changefreq   String   @default("")
  priority     String   @default("")
  status       String   @default("valid")
  qualityScore Int      @default(0)
  issues       Json?
  metadata     Json?
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([siteId, url])
  @@index([tenantId, status])
  @@index([siteId, qualityScore])
}

model SeoUrlInspection {
  id         String   @id @default(cuid())
  tenantId   String
  siteId     String
  site       SeoSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url        String
  indexed    Boolean  @default(false)
  canonical  String   @default("")
  lastCrawl  DateTime?
  status     String   @default("pending")
  raw         Json?
  inspectedAt DateTime @default(now())

  @@unique([siteId, url])
  @@index([tenantId, indexed])
}

model SeoRecommendation {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId      String?
  site        SeoSite? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title       String
  description String
  impact      String   @default("medium")
  priority    String   @default("medium")
  source      String   @default("system")
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([siteId, priority])
}
